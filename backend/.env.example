# Modelo do backend/.env. Copie para .env e gere os segredos; nunca reaproveite
# os de outro projeto: segredo repetido junta dois sistemas.

MONGO_URL=mongodb://127.0.0.1:27019
DB_NAME=turismo_local
CORS_ORIGINS=http://localhost:3010

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

ADMIN_EMAIL=
ADMIN_PASSWORD=

COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:8010

# WhatsApp Cloud API (app da Meta do turismo)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PLATFORM_TOKEN=

# Canal não oficial (WuzAPI): só com ponte própria do turismo.
WUZAPI_URL=http://127.0.0.1:9
WUZAPI_ADMIN_TOKEN=

# Site público das agências (fase 3): {slug}.SITE_DOMINIO.
# Local: localhost:8010 (o navegador resolve *.localhost sozinho).
# Produção: o domínio dos sites, sem porta, e https.
SITE_DOMINIO=localhost:8010
SITE_ESQUEMA=http
# Hosts do painel/API, que nunca são tratados como site.
APP_HOSTS=localhost,127.0.0.1

# Erros no Sentry (opcional). Sem DSN, os erros ficam só no log. O health
# (/api/health) confere banco e workers e responde 503 quando algo caiu: é o
# endereço para o monitor de disponibilidade externo.
SENTRY_DSN=
SENTRY_AMBIENTE=producao
