# Porta de entrada do 4turismo em produção. Os domínios vêm do infra/.env.
#
#   APP_DOMINIO       painel + /api           (ex.: app.4turismo.com.br)
#   SITE_DOMINIO      base dos sites          (ex.: 4turismo.com.br, sites em
#                                              agencia.4turismo.com.br)
#   domínio próprio   www.agencia.com.br, com CNAME para o subdomínio dela
#
# O certificado de cada site é emitido na hora do primeiro acesso (on_demand),
# e só depois de o backend dizer que aquele endereço é de um site publicado
# (/api/publico/tls-ask). Sem o "ask", qualquer um apontaria um domínio para o
# servidor e o faria pedir certificados até estourar o limite da Let's Encrypt.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://backend:8000/api/publico/tls-ask
	}
}

# Painel: o build do React (estático) e a API.
{$APP_DOMINIO} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		# Arquivos com hash no nome nunca mudam; o index.html sempre muda.
		@hash path /static/*
		header @hash Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log
}

# O domínio base sozinho ainda não é página de nada: leva ao painel.
{$SITE_DOMINIO} {
	redir https://{$APP_DOMINIO}{uri}
}

# Sites das agências (subdomínios do base e domínios próprios): qualquer outro
# host que chegue por HTTPS. O backend descobre a agência pelo Host.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy backend:8000
	log
}

# HTTP de qualquer host vai para o HTTPS. O desafio da Let's Encrypt é
# respondido pelo Caddy antes desta regra.
http:// {
	redir https://{host}{uri} permanent
}
