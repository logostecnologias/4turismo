# Produção do 4turismo. Copie para infra/.env e preencha. Nunca versione o .env
# e nunca reaproveite segredo de outro projeto: segredo repetido junta dois
# sistemas sem erro nenhum aparecer.
#
# Guarde uma cópia do .env preenchido FORA do servidor (gerenciador de senhas).
# Sem CREDENTIALS_KEY as credenciais cifradas no banco viram lixo; sem
# WUZAPI_ENCRYPTION_KEY todos os números precisam ler o QR de novo.
#
# Gerar segredos (no servidor):
#   openssl rand -hex 32      -> JWT_SECRET, MONGO_SENHA, WUZAPI_DB_SENHA, WUZAPI_ADMIN_TOKEN
#   openssl rand -hex 16      -> WUZAPI_ENCRYPTION_KEY (32 caracteres)
#   docker run --rm python:3.11-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
#                             -> CREDENTIALS_KEY
# Use hex nas senhas: elas entram numa URL de conexão, e caractere especial ali
# quebra a conexão sem mensagem clara.

# --- Domínios -----------------------------------------------------------------
# Painel. DNS: registro A apontando para o servidor.
APP_DOMINIO=app.4turismo.com.br
# Base dos sites das agências. DNS: registro A do próprio domínio e registro A
# curinga (*.4turismo.com.br) apontando para o servidor.
SITE_DOMINIO=4turismo.com.br
# E-mail para a Let's Encrypt avisar de certificado com problema.
ACME_EMAIL=contato@logostecnologias.com

# --- Segredos do backend --------------------------------------------------------
JWT_SECRET=
CREDENTIALS_KEY=
MONGO_SENHA=

# Super admin semeado na primeira subida (login do painel de agências).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- WhatsApp: ponte WuzAPI própria ---------------------------------------------
# O mesmo token vai para a ponte (admin) e para o backend (cria as instâncias).
WUZAPI_ADMIN_TOKEN=
WUZAPI_ENCRYPTION_KEY=
WUZAPI_DB_SENHA=

# --- Monitoramento (opcional, recomendado) --------------------------------------
# Erros no Sentry: crie um projeto Python/FastAPI e cole o DSN.
SENTRY_DSN=
SENTRY_AMBIENTE=producao

# --- IA da plataforma (opcional) -------------------------------------------------
# Sem ela, agente de IA e tradução do site só funcionam com a chave da agência.
# Provedor: openai (padrão), anthropic, groq, gemini, openrouter... Modelo vazio
# = o padrão do provedor.
AI_PLATFORM_KEY=
AI_PLATFORM_PROVIDER=openai
AI_PLATFORM_MODEL=

# --- Backup (infra/backup.sh) ------------------------------------------------------
# Destino do rclone para a cópia fora do servidor (ex.: b2:4turismo-backup).
# Vazio = só no disco do servidor, o que não protege de perder o servidor.
BACKUP_REMOTO=
BACKUP_DIAS=14

# A Cloud API oficial não é usada (decisão de 16/10/2026). Ficam vazias; o
# backend avisa no log que os webhooks da Meta estão desligados, e é isso mesmo.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PLATFORM_TOKEN=
